#!/usr/bin/env bash
#
# bin/mimi — macOS junk cleaner (Apple Silicon safe, Xcode/simulator aware)
# Usage: see README.md or run `mimi --help`
#
# Written for bash 3.2+ compatibility (no associative arrays) since macOS's
# system /bin/bash is still 3.2 even when a newer bash is on PATH.
#
# This file is the entry point: it locates lib/, loads it, parses arguments and
# dispatches. Everything else lives in lib/. The repository root still has a
# clean.sh shim, so the invocation documented before the rename still works.

set -uo pipefail
shopt -s nullglob

# ---------------------------------------------------------------------------
# Locate lib/
#
# Resolved from BASH_SOURCE, not from $0 or $PWD. $0 is deliberately not used:
# the clean.sh shim sources this file so that the program still calls itself
# "clean.sh" in its messages, which means $0 points at the shim, not here.
# Symlinks to this file are followed so it can be linked onto PATH.
# ---------------------------------------------------------------------------

_mimi_self="${BASH_SOURCE[0]}"
while [ -L "$_mimi_self" ]; do
  _mimi_dir="$(cd -P "$(dirname "$_mimi_self")" > /dev/null 2>&1 && pwd)"
  _mimi_self="$(readlink "$_mimi_self")"
  case "$_mimi_self" in
    /*) ;;
    *) _mimi_self="$_mimi_dir/$_mimi_self" ;;
  esac
done
_mimi_dir="$(cd -P "$(dirname "$_mimi_self")" > /dev/null 2>&1 && pwd)"

# Not overridable from the environment on purpose: this path is sourced, so an
# override would be arbitrary code execution wearing a configuration hat.
MIMI_LIB_DIR="$_mimi_dir/../lib"
if [ ! -f "$MIMI_LIB_DIR/load.sh" ]; then
  printf '%s: error: cannot find lib/load.sh next to %s\n' "$(basename "$0")" "$_mimi_dir" >&2
  exit 1
fi

# shellcheck source=lib/load.sh
. "$MIMI_LIB_DIR/load.sh"
unset _mimi_self _mimi_dir

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

migrate_legacy_state
load_config

# Bare invocation from an actual terminal drops into the interactive menu;
# any flag at all keeps the script fully scriptable/non-interactive as before.
if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
  INTERACTIVE=1
fi

while [ $# -gt 0 ]; do
  case "$1" in
    scan) MODE="scan"; shift ;;
    clean) MODE="clean"; shift ;;
    plan) MODE="plan"; shift ;;
    apps)
      MODE="apps"
      shift
      if [ $# -gt 0 ] && [ "$1" = "list" ]; then
        shift
      fi
      ;;
    app)
      shift
      if [ $# -gt 0 ]; then
        case "$1" in
          inspect)
            MODE="app_inspect"
            shift
            if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
              APP_TARGET="$1"
              shift
            fi
            ;;
          uninstall)
            MODE="app_uninstall"
            shift
            if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
              APP_TARGET="$1"
              shift
            fi
            ;;
          list)
            MODE="apps"
            shift
            ;;
          *)
            if [[ "$1" != -* ]]; then
              APP_TARGET="$1"
              MODE="app_inspect"
              shift
            else
              MODE="apps"
            fi
            ;;
        esac
      else
        MODE="apps"
      fi
      ;;
    apply)
      require_arg "apply" "$#" "${2-}"
      MODE="apply"
      PLAN_FILE="$2"
      shift 2 ;;
    restore)
      require_arg "restore" "$#" "${2-}"
      MODE="restore"
      RUN_ID="$2"
      shift 2 ;;
    purge)
      require_arg "purge" "$#" "${2-}"
      MODE="purge"
      RUN_ID="$2"
      shift 2 ;;
    --plan) MODE="plan"; shift ;;
    --plan-out)
      require_arg "--plan-out" "$#" "${2-}"
      PLAN_OUT_FILE="$2"; shift 2 ;;
    --plan-out=*)
      PLAN_OUT_FILE="${1#*=}"; shift ;;
    --apply)
      require_arg "--apply" "$#" "${2-}"
      MODE="apply"
      PLAN_FILE="$2"
      shift 2 ;;
    --apply=*)
      MODE="apply"
      PLAN_FILE="${1#*=}"; shift ;;
    --restore)
      require_arg "--restore" "$#" "${2-}"
      MODE="restore"
      RUN_ID="$2"
      shift 2 ;;
    --restore=*)
      MODE="restore"
      RUN_ID="${1#*=}"; shift ;;
    --purge)
      require_arg "--purge" "$#" "${2-}"
      MODE="purge"
      RUN_ID="$2"
      shift 2 ;;
    --purge=*)
      MODE="purge"
      RUN_ID="${1#*=}"; shift ;;
    --source)
      require_arg "--source" "$#" "${2-}"
      APP_SOURCE_FILTER="$2"; shift 2 ;;
    --source=*)
      APP_SOURCE_FILTER="${1#*=}"; shift ;;
    --app-target)
      require_arg "--app-target" "$#" "${2-}"
      APP_TARGET="$2"; shift 2 ;;
    --app-target=*)
      APP_TARGET="${1#*=}"; shift ;;
    # Repeatable: the first --app-root replaces the default roots, later ones
    # are added to it.
    --app-root)
      require_arg "--app-root" "$#" "${2-}"
      app_add_search_root "$2"; shift 2 ;;
    --app-root=*)
      app_add_search_root "${1#*=}"; shift ;;
    --keep-data)
      UNINSTALL_DATA_MODE="keep"; shift ;;
    --purge-data)
      UNINSTALL_DATA_MODE="purge"; shift ;;
    --cask)
      UNINSTALL_DELEGATE_CASK=1; shift ;;
    --zap)
      UNINSTALL_ZAP=1; shift ;;
    -i|--interactive) INTERACTIVE=1; shift ;;
    --scan) MODE="scan"; shift ;;
    --jsonl | --json) JSONL_ENABLED=1; shift ;;
    --request-id)
      require_arg "--request-id" "$#" "${2-}"
      JSON_REQ_ID="$2"; shift 2 ;;
    --request-id=*)
      JSON_REQ_ID="${1#*=}"; shift ;;
    --no-color)
      NO_COLOR=1
      C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_CYAN=""
      shift ;;
    --no-prompt)
      INTERACTIVE=0
      shift ;;
    # --cleaner is the documented spelling; --clean is kept because it is what
    # every existing script and every version of the README until now used.
    --cleaner | --clean) MODE="clean"; shift ;;
    -y|--yes) ASSUME_YES=1; shift ;;
    # Deliberately has no short form and no "all": each risky or irreversible
    # action has to be named, which is the entire difference between this and
    # --yes. See lib/confirm.sh.
    --force-risky)
      require_arg "--force-risky" "$#" "${2-}"
      FORCE_RISKY_LIST="$(normalize_force_risky_list "--force-risky" "$2")" || exit "$EXIT_USAGE"
      shift 2 ;;
    --force-risky=*)
      FORCE_RISKY_LIST="$(normalize_force_risky_list "--force-risky" "${1#*=}")" || exit "$EXIT_USAGE"
      shift ;;
    -v|--verbose) VERBOSE=1; shift ;;
    --aggressive) AGGRESSIVE=1; shift ;;
    --keep-device-support)
      require_arg "--keep-device-support" "$#" "${2-}"
      validate_int "--keep-device-support" "$2"
      KEEP_DEVICE_SUPPORT="$2"; shift 2 ;;
    --keep-device-support=*)
      validate_int "--keep-device-support" "${1#*=}"
      KEEP_DEVICE_SUPPORT="${1#*=}"; shift ;;
    --only)
      require_arg "--only" "$#" "${2-}"
      ONLY_LIST="$(normalize_category_list "--only" "$2")" || exit "$EXIT_USAGE"; shift 2 ;;
    --only=*)
      ONLY_LIST="$(normalize_category_list "--only" "${1#*=}")" || exit "$EXIT_USAGE"; shift ;;
    --skip)
      require_arg "--skip" "$#" "${2-}"
      SKIP_LIST="$(normalize_category_list "--skip" "$2")" || exit "$EXIT_USAGE"; shift 2 ;;
    --skip=*)
      SKIP_LIST="$(normalize_category_list "--skip" "${1#*=}")" || exit "$EXIT_USAGE"; shift ;;
    --whitelist)
      require_arg "--whitelist" "$#" "${2-}"
      IFS=',' read -r -a _wl <<< "$2"; WHITELIST+=("${_wl[@]}"); shift 2 ;;
    --whitelist=*)
      IFS=',' read -r -a _wl <<< "${1#*=}"; WHITELIST+=("${_wl[@]}"); shift ;;
    --whitelist-preset)
      require_arg "--whitelist-preset" "$#" "${2-}"
      apply_whitelist_preset "$2" || exit "$EXIT_USAGE"; shift 2 ;;
    --whitelist-preset=*)
      apply_whitelist_preset "${1#*=}" || exit "$EXIT_USAGE"; shift ;;
    --include-trash) INCLUDE_TRASH=1; shift ;;
    --include-mail) INCLUDE_MAIL=1; shift ;;
    --include-docker) INCLUDE_DOCKER=1; shift ;;
    --include-docker-cache) INCLUDE_DOCKER_CACHE=1; shift ;;
    --include-orphans) INCLUDE_ORPHANS=1; shift ;;
    --include-whatsapp) INCLUDE_WHATSAPP=1; shift ;;
    --include-sim-stale) INCLUDE_SIM_STALE=1; shift ;;
    --sim-stale-days)
      require_arg "--sim-stale-days" "$#" "${2-}"
      validate_int "--sim-stale-days" "$2"
      SIM_STALE_DAYS="$2"; shift 2 ;;
    --sim-stale-days=*)
      validate_int "--sim-stale-days" "${1#*=}"
      SIM_STALE_DAYS="${1#*=}"; shift ;;
    --include-claude-cache) INCLUDE_CLAUDE_CACHE=1; shift ;;
    --include-android) INCLUDE_ANDROID=1; shift ;;
    --include-ide-stale) INCLUDE_IDE_STALE=1; shift ;;
    --include-ml-caches) INCLUDE_ML_CACHES=1; shift ;;
    --include-ios-backups) INCLUDE_IOS_BACKUPS=1; shift ;;
    --include-toolchains) INCLUDE_TOOLCHAINS=1; shift ;;
    --include-timemachine) INCLUDE_TIMEMACHINE=1; shift ;;
    --include-device-support) INCLUDE_DEVICE_SUPPORT=1; shift ;;
    --include-homebrew-old) INCLUDE_HOMEBREW_OLD=1; shift ;;
    --include-caches) INCLUDE_CACHES=1; shift ;;
    --include-logs) INCLUDE_LOGS=1; shift ;;
    --profile)
      require_arg "--profile" "$#" "${2-}"
      if [ "$2" = "list" ]; then
        print_profile_list
        exit 0
      fi
      validate_profile "--profile" "$2"
      PROFILE="$2"; shift 2 ;;
    --profile=*)
      _p="${1#*=}"
      if [ "$_p" = "list" ]; then
        print_profile_list
        exit 0
      fi
      validate_profile "--profile" "$_p"
      PROFILE="$_p"; shift ;;
    --tmp-stale-days)
      require_arg "--tmp-stale-days" "$#" "${2-}"
      validate_int "--tmp-stale-days" "$2"
      TMP_STALE_DAYS="$2"; shift 2 ;;
    --tmp-stale-days=*)
      validate_int "--tmp-stale-days" "${1#*=}"
      TMP_STALE_DAYS="${1#*=}"; shift ;;
    --keep-toolchains)
      require_arg "--keep-toolchains" "$#" "${2-}"
      validate_int "--keep-toolchains" "$2"
      KEEP_TOOLCHAINS="$2"; shift 2 ;;
    --keep-toolchains=*)
      validate_int "--keep-toolchains" "${1#*=}"
      KEEP_TOOLCHAINS="${1#*=}"; shift ;;
    --report) REPORT_ONLY=1; shift ;;
    --no-log) NO_LOG=1; shift ;;
    --keep-logs)
      require_arg "--keep-logs" "$#" "${2-}"
      validate_int "--keep-logs" "$2"
      KEEP_LOGS="$2"; shift 2 ;;
    --keep-logs=*)
      validate_int "--keep-logs" "${1#*=}"
      KEEP_LOGS="${1#*=}"; shift ;;
    --android-stale-days)
      require_arg "--android-stale-days" "$#" "${2-}"
      validate_int "--android-stale-days" "$2"
      ANDROID_STALE_DAYS="$2"; shift 2 ;;
    --android-stale-days=*)
      validate_int "--android-stale-days" "${1#*=}"
      ANDROID_STALE_DAYS="${1#*=}"; shift ;;
    # Quarantine every leftover the orphan scan finds (strong and weak). Naming
    # the action is its authorization; it also selects the orphans category.
    --remove-orphans) REMOVE_ORPHANS=1; INCLUDE_ORPHANS=1; shift ;;
    --remove-orphans-from)
      require_arg "--remove-orphans-from" "$#" "${2-}"
      [ -r "$2" ] || die_usage "--remove-orphans-from: cannot read review file '$2'"
      REMOVE_ORPHANS_FILE="$2"; shift 2 ;;
    --remove-orphans-from=*)
      [ -r "${1#*=}" ] || die_usage "--remove-orphans-from: cannot read review file '${1#*=}'"
      REMOVE_ORPHANS_FILE="${1#*=}"; shift ;;
    --list) print_category_list; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *)
      err "unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

# The config file gets the same treatment the CLI just got. Deliberately after
# the parse loop: --help and --list exit inside it, so documentation stays
# reachable even when the saved config is broken.
validate_config_values

# Apply default-on/off filtering only when --only wasn't explicitly given.
#
# Precedence:
# 1. --only (CLI flag)
# 2. --profile (CLI flag)
# 3. CONFIG_SELECTED_CATEGORIES (from saved config file)
# 4. CONFIG_PROFILE (from saved config file)
# 5. Default profile ("safe")
#
# Any --include-X flag adds X to ONLY_LIST and opens its gate.
# --skip always wins over any of the above.
if [ "$MODE" != "apps" ] && [ "$MODE" != "app_inspect" ] && [ "$MODE" != "app_uninstall" ]; then
  if [ -z "$ONLY_LIST" ]; then
    if [ -n "$PROFILE" ]; then
      ONLY_LIST="$(profile_category_list "$PROFILE")"
    elif [ -n "$CONFIG_SELECTED_CATEGORIES" ]; then
      ONLY_LIST="$CONFIG_SELECTED_CATEGORIES"
    elif [ -n "$CONFIG_PROFILE" ]; then
      ONLY_LIST="$(profile_category_list "$CONFIG_PROFILE")"
    else
      ONLY_LIST="$(profile_category_list "safe")"
    fi
    # An opt-in category named in the profile or saved selection also needs its
    # --include-* gate opened, or it would appear in the run list and then
    # refuse to do anything ("skipped (opt-in only)").
    for _id in $ALL_CATEGORY_IDS; do
      case ",$ONLY_LIST," in
        *",$_id,"*)
          _var="$(category_include_var "$_id")"
          [ -n "$_var" ] && printf -v "$_var" '1'
          ;;
      esac
    done
  fi

  # Any --include-X flag is itself an explicit request to run that category,
  # whether or not --only named it (or code defaults would have included it).
  # --skip still wins (checked first in should_run_category).
  for _id in $ALL_CATEGORY_IDS; do
    _var="$(category_include_var "$_id")"
    if [ -n "$_var" ] && [ "${!_var}" = "1" ]; then
      case ",$ONLY_LIST," in
        *",$_id,"*) ;;
        *) ONLY_LIST="${ONLY_LIST:+$ONLY_LIST,}$_id" ;;
      esac
    fi
  done
fi

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

if [ "$INTERACTIVE" = 1 ]; then
  interactive_main
else
  main
fi
