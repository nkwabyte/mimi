{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MimiPlanV1",
  "description": "Schema for Mimi Transactional Execution Plans (v1)",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "expires_at",
    "host_binding",
    "digest",
    "summary",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "host_binding": {
      "type": "object",
      "required": ["hostname", "user"],
      "properties": {
        "hostname": { "type": "string" },
        "user": { "type": "string" },
        "uid": { "type": "integer" },
        "os_version": { "type": "string" }
      }
    },
    "digest": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": ["total_candidates", "total_bytes"],
      "properties": {
        "total_candidates": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "risk_distribution": {
          "type": "object",
          "properties": {
            "safe": { "type": "integer" },
            "moderate": { "type": "integer" },
            "risky": { "type": "integer" },
            "irreversible": { "type": "integer" }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_id", "category", "operation", "target_path", "target_identity", "expected_bytes", "risk"],
        "properties": {
          "action_id": { "type": "string" },
          "category": { "type": "string" },
          "operation": {
            "type": "string",
            "enum": ["remove_path", "clear_dir_contents", "quarantine", "tool_cleanup"]
          },
          "target_path": { "type": "string" },
          "target_identity": { "type": "string" },
          "expected_bytes": { "type": "integer", "minimum": 0 },
          "risk": {
            "type": "string",
            "enum": ["safe", "moderate", "risky", "irreversible"]
          },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
